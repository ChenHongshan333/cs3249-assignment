# Copy this file to backend/.env and fill in your own key. Never commit .env.
# Values here override system environment variables of the same name.
# If OPENROUTER_API_KEY is already set as a system environment variable, you can leave it out here.

# OpenRouter (OpenAI-compatible API). Both chat and embeddings use this key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Chat model used for query rewriting, answers, critical review, judgment feedback and notes.
CHAT_MODEL=anthropic/claude-haiku-5.5
CHAT_TEMPERATURE=0.2

# Embedding model used for retrieval (via OpenRouter's /embeddings endpoint).
EMBEDDING_MODEL=openai/text-embedding-3-small

# Pipeline version recorded in every log entry.
#   v1 = full pipeline (history-aware query rewriting, overview routing, citation validation)
#   v0 = ablated baseline (raw message used as query, no overview routing, no citation validation)
PIPELINE_VERSION=v1

# Retrieval / chunking settings
TOP_K=6
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Where uploaded PDFs, the Chroma index, sessions and logs are stored (relative to backend/).
DATA_DIR=data
